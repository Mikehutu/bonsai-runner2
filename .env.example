# Ternary Bonsai 2.5 27B Runner — Environment Configuration
# Copy to .env and adjust as needed:  cp .env.example .env
# Both start.sh and start.ps1 automatically load .env if present.

# ─── Model Variant ────────────────────────────────────
# auto (default): CUDA/ROCm/HIP -> ptq1-mtp (6.23 GB), Metal/Vulkan/CPU -> pq2-mtp (7.49 GB)
# Explicit options: ptq1-mtp | pq2-mtp | q2-mtp | ptq1 | pq2 | q2 | mlx (Apple Silicon only)
# MODEL_VARIANT=auto

# ─── Server ───────────────────────────────────────────
# Port for llama-server (auto-falls back to PORT+1, PORT+2 if busy)
PORT=8080

# Bind address (0.0.0.0 = all interfaces, 127.0.0.1 = localhost only)
HOST=0.0.0.0

# ─── Mode & Speculative Decoding (MTP) ────────────────
# thinking (default): temp 1.0, top_p 0.95, top_k 20, min_p 0 (reasoning effort xhigh)
# instruct: non-thinking mode (temp 0.7, top_p 0.80, presence_penalty 1.5)
MODE=thinking

# Built-in Multi-Token Prediction (MTP) draft head on *-mtp.gguf files:
# auto (default): ON for CUDA/ROCm/HIP (n-max=3, p-min=0.1) & Metal (n-max=1, p-min=0.6); OFF for CPU/Vulkan
# on / off: force enable or disable
MTP=auto
# MTP_NMAX=3
# MTP_PMIN=0.1

# ─── Hardware & Memory ────────────────────────────────
# Force backend: cuda | rocm | vulkan | metal | cpu (Windows: cuda | hip | vulkan | cpu)
# BACKEND=

# GPU layers to offload (99 = all layers; automatically 0 on CPU backend)
NGL=99

# Context length in tokens. 0 = safe 32K default (32768). Max supported: 262144 (262K).
CONTEXT_SIZE=0

# Concurrent server slots (-np).
# 1 (default) keeps VRAM under ~8 GB on 8-10 GB GPUs (model card recommendation).
# Set to 0 for llama-server auto, or 4+ for concurrent serving on high-VRAM machines.
PARALLEL=1

# 4-bit KV cache (1 = enable --cache-type-k q4_0 --cache-type-v q4_0 for long contexts on tight RAM/VRAM)
KV4=0

# ─── Vision (Multimodal Projector) ────────────────────
# Set NO_VISION=1 to skip downloading/loading the vision projector (~0.63 GB)
NO_VISION=0

# Vision projector quantization: Q8_0 (0.63 GB, default) or BF16 (0.93 GB)
MMPROJ_QUANT=Q8_0

# Keep vision projector in system RAM instead of VRAM (1 = --no-mmproj-offload)
MMPROJ_CPU=0

# Max vision tokens per image (1024 = fast default; 0 = uncapped for small-text OCR)
IMAGE_MAX_TOKENS=1024

# ─── Runtime & Cache ──────────────────────────────────
# Pinned PrismML llama.cpp release tag (or 'latest' to query GitHub Releases)
# PRISM_RELEASE=prism-b12178-03ec600

# Force compiling PrismML llama.cpp from source instead of downloading prebuilt binaries (start.sh only)
# BUILD_FROM_SOURCE=0

# Optional HuggingFace token and airgapped offline mode
# HF_TOKEN=
# HF_HUB_OFFLINE=0

# Custom cache directory (default: ~/.bonsai25)
# BONSAI25_DIR=~/.bonsai25
